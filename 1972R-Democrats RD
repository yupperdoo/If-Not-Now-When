(function () {

  campaignTrail_temp.VisitText = "";
  campaignTrail_temp.VisitText2 = "";

  function updateVisitWindow() {
    const p = document.querySelector("#visit_window .overlay_window_content p");
    if (!p) return;

    const text = p.textContent || "";

    // must be a state name match
    const state = campaignTrail_temp.states_json.find(s =>
      text.includes(s.fields.name)
    );

    if (!state) return;

    // reject non-visit screens by structure (they usually don't have the prompt)
    const isVisitPrompt = text.includes("Is this where you want to visit?");
    const looksLikeNarrative = text.length > 220;

    if (!isVisitPrompt && looksLikeNarrative) return;

    const custom = window.visitTextDB?.[state.pk] || "";

    p.innerHTML =
      `${state.fields.name}</b> ${custom}<br><br>` +
      `Is this where you want to visit?`;
  }

  setInterval(updateVisitWindow, 1);

})();

document.addEventListener("click", function (e) {
  const okBtn = e.target.closest("#ok_button");
  if (!okBtn) return;

  console.log("OK clicked");

  // Try to find ANY visible overlay-like container
  const overlays = document.querySelectorAll(".overlay_window, #feedback_window, [class*='overlay']");

  overlays.forEach((el) => {
    const style = window.getComputedStyle(el);

    // Only act on visible ones
    if (style.display !== "none" && style.visibility !== "hidden" && style.opacity !== "0") {
      console.log("Removing overlay:", el);

      // HARD REMOVE (bypasses state bugs)
      el.remove();
    }
  });
});
