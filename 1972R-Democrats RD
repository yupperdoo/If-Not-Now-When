document.addEventListener(
    "keydown",
    function (e) {

        if (!window.hqLocked) return;

        // LEFT ARROW = press Back
        if (e.key === "ArrowLeft") {

            e.preventDefault();
            e.stopImmediatePropagation();

            const back =
                document.querySelector("#headquarter button");

            if (back) {
                back.click();
            }

            return;
        }

        // block all other navigation keys
        const blocked = [
            "ArrowRight",
            "ArrowUp",
            "ArrowDown",
            "Enter",
            " "
        ];

        if (blocked.includes(e.key)) {
            e.preventDefault();
            e.stopImmediatePropagation();
        }

    },
    true
);

