function calculateCandidateElectoralVotes(finalResults) {
    let NixonEV = 0;
    let DemEV = 0;
    let WallaceEV = 0;
    let FourthPartyEV = 0;

    finalResults.forEach(stateResult => {

        const resultsArray = stateResult.result || stateResult.results;

        if (!resultsArray) return;

        resultsArray.forEach(candidateResult => {

            const id = candidateResult.candidate;
            const ev = candidateResult.electoral_votes;

            switch (id) {
                case 200: // Nixon
                    NixonEV += ev;
                    break;

                case 201: // Democrat
                    DemEV += ev;
                    break;

                case 202: // Wallace / South (if used)
                    WallaceEV += ev;
                    break;

                default:
                    FourthPartyEV += ev;
                    break;
            }
        });
    });

    return { NixonEV, DemEV, WallaceEV, FourthPartyEV };
}

