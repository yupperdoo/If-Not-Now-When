": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1035, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1036, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1037, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1038, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1039, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1040, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.05}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1041, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1042, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1043, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_trail.answer_score_state\", \"pk\": 7912, \"fields\": {\"answer\": 2912, \"state\": 1044, \"candidate\": 201, \"affected_candidate\": 200, \"state_multiplier\": 0.0}}, {\"model\": \"campaign_